const SHEET_ID=PropertiesService.getScriptProperties().getProperty("SHEET_ID")||"",REQUIRE_WORKER=true,APP_ORIGIN="https://athithiyanmr.github.io";
function ss_(){return SHEET_ID?SpreadsheetApp.openById(SHEET_ID):SpreadsheetApp.getActiveSpreadsheet()}
function sheet_(n,h){let s=ss_().getSheetByName(n);if(!s)s=ss_().insertSheet(n);if(s.getLastRow()===0)s.appendRow(h);return s}
function setup(){sheet_("verifications",["quarry_id","status","confidence","water","water_type","type","activity","note","worker_name","worker_email","timestamp","geometry_json"]);sheet_("workers",["email","name","active"]);return"Setup complete"}
function doGet(e){try{const a=e.parameter.action||"health";if(a==="authorizeFrame")return frame_(authorize_(e.parameter.name),e.parameter._id);if(a==="getAllFrame")return frame_(getAll_(),e.parameter._id);if(a==="registerFrame")return frame_(register_(e.parameter.name),e.parameter._id);if(a==="authorize")return out_(authorize_(e.parameter.name));if(a==="register")return out_(register_(e.parameter.name));if(a==="getAll")return out_(getAll_());return out_({ok:true,service:"Kerala Quarry Verification Tool"})}catch(x){return out_({ok:false,message:String(x)})}}
function doPost(e){try{const b=JSON.parse((e.parameter&&e.parameter.payload)||((e.postData&&e.postData.contents)||"{}")),w=b.worker||{};if(REQUIRE_WORKER&&!valid_(w.name))return out_({ok:false,message:"Worker is not authorized"});if(b.action==="saveVerification")return save_(b.feature,w);return out_({ok:false,message:"Unknown action"})}catch(x){return out_({ok:false,message:String(x)})}}
function valid_(name){const s=ss_().getSheetByName("workers");if(!s||!name)return false;const v=s.getDataRange().getValues(),nm=String(name).trim().toLowerCase();return v.slice(1).some(r=>String(r[1]).trim().toLowerCase()===nm&&String(r[2]).trim().toLowerCase()!=="false")}
function authorize_(name){const ok=valid_(name);return{ok:ok,authorized:ok,message:ok?"Access granted":"Name is not registered. Click Register to create an account."}}
function register_(name){name=String(name||"").trim();if(!name)return{ok:false,message:"Please enter your name."};if(name.length<2)return{ok:false,message:"Please enter a valid name."};const s=sheet_("workers",["email","name","active"]),v=s.getDataRange().getValues(),nm=name.toLowerCase();for(let i=1;i<v.length;i++){if(String(v[i][1]).trim().toLowerCase()===nm){if(String(v[i][2]).trim().toLowerCase()!=="false")return{ok:true,registered:true,existing:true,message:"Name is already registered. You can log in."};return{ok:false,message:"This name is registered but inactive. Ask the administrator to reactivate it."}}}s.appendRow(["",name,true]);return{ok:true,registered:true,existing:false,message:"Registration successful. You can now log in."}}
function save_(f,w){const p=f.properties||{},id=p.quarry_id;if(!id)return out_({ok:false,message:"Missing quarry_id"});const s=sheet_("verifications",["quarry_id","status","confidence","water","water_type","type","activity","note","worker_name","worker_email","timestamp","geometry_json"]),row=[id,p.verification_status||"",p.verification_confidence||"",p.water_verified||"",p.water_type||"",p.quarry_type_std||"",p.activity_status||"",p.verification_note||"",w.name||"",w.email||"",new Date(),JSON.stringify(f.geometry||null)];const v=s.getDataRange().getValues();let at=-1;for(let i=1;i<v.length;i++)if(String(v[i][0])===String(id)){at=i+1;break}if(at>0)s.getRange(at,1,1,row.length).setValues([row]);else s.appendRow(row);return out_({ok:true,quarry_id:id})}
function getAll_(){const s=ss_().getSheetByName("verifications");if(!s)return{ok:true,records:[]};const v=s.getDataRange().getValues();return{ok:true,records:v.slice(1).map(r=>({quarry_id:r[0],status:r[1],confidence:r[2],water:r[3],water_type:r[4],type:r[5],activity:r[6],note:r[7],timestamp:r[10],geometry_json:r[11]}))}}
function frame_(o,id){const j=JSON.stringify(o).replace(/<\\/g,"<\\\\/");const h='<!doctype html><html><body><script>parent.postMessage({"_id":'+JSON.stringify(id)+',"payload":'+j+'},'+JSON.stringify(APP_ORIGIN)+');<\\/script></body></html>';return HtmlService.createHtmlOutput(h).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}